# Backend implementation, chosen at build time: supabase (default) or gcp.
# gcp talks to the same-origin server in server/ (behind Google IAP) and needs none of the
# variables below; in dev, run `npm run dev:server` too (Vite proxies /api to localhost:8080).
VITE_BACKEND=supabase

# Supabase backend only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_LINEAR_CLIENT_ID=your-linear-oauth-client-id
VITE_LINEAR_REDIRECT_URI=http://localhost:5173/callback
